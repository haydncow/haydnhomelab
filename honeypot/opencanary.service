[Unit]
Description=OpenCanary honeypot (home network only)
After=network-online.target
Wants=network-online.target

[Service]
User=canary
Group=canary
# opencanaryd calls "python3" and "twistd" itself, so make sure it finds the
# ones inside its own virtual environment, not the system ones
Environment=PATH=/opt/opencanary/bin:/usr/bin:/bin
ExecStart=/opt/opencanary/bin/opencanaryd --dev
Restart=always
RestartSec=10

# Ports 21 and 23 are below 1024, so give it just that one permission
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Lock it down: if someone broke the honeypot, they'd be stuck in here
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/opencanary
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
