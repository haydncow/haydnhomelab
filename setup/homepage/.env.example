# Copy to .env on the Pi (chmod 600). Never commit the real one.
HOMEPAGE_VAR_PIHOLE_KEY=paste-your-pihole-app-password-here
HOMEPAGE_VAR_JELLYFIN_KEY=paste-a-jellyfin-api-key-here
HOMEPAGE_VAR_SPEEDTEST_KEY=paste-a-speedtest-tracker-api-token-here
# The addresses you open the dashboard on, comma separated, each with :3000 unless it goes through Caddy
HOMEPAGE_ALLOWED_HOSTS=dashboard.lan,localhost:3000
