# /etc/caddy/Caddyfile

# Status page, only on the Pi itself for the Cloudflare Tunnel
:8080 {
	bind 127.0.0.1
	root * /srv/status
	file_server
	header /live.json Cache-Control no-store
	header /stats.json Cache-Control no-store
}

# Speedtest Tracker, UFW only allows this from home and Tailscale
:8766 {
	reverse_proxy 127.0.0.1:8765
}
